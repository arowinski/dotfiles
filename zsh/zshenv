export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

eval "$(/opt/homebrew/bin/brew shellenv)"
export PATH="/usr/local/bin:$PATH"
export PATH="$HOME/.bin:$PATH"

export VISUAL=nvim
export EDITOR="$VISUAL"

export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

export ERL_AFLAGS="-kernel shell_history enabled -kernel shell_history_file_bytes 1024000"

export CLICOLOR=1
export DIRENV_LOG_FORMAT=

eval "$(mise activate zsh)"

# Workspace tooling (ws, ws-popup, ensure-docker) ships in the workspace repo's bin/;
# see $WS_LOCAL/docs/workspaces.md. Root overridable per machine, guarded when absent.
export WS_LOCAL="${WS_LOCAL:-$HOME/gat/gat-local}"
[ -d "$WS_LOCAL/bin" ] && export PATH="$WS_LOCAL/bin:$PATH"

# mise activate prepends ~/.local/bin; re-prepend ~/.bin so our shims win.
export PATH="$HOME/.bin:$PATH"

# mise activate only exports bin dirs for tools installed when the shell started,
# so a tool added later is missing from any process that inherited this PATH.
# Append the shims dir as a fallback: it resolves whatever version the config pins.
export PATH="$PATH:$HOME/.local/share/mise/shims"

# Per-workspace env (ports, DB) is not loaded here: each worktree's mise.toml does it,
# via `mise activate` above. See $WS_LOCAL/docs/claude/dev-session.md, "Workspace env".
