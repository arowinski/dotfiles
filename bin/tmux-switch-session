#!/bin/bash
#
# Switch to next/prev tmux session, skipping hidden scratch sessions.

current=$(tmux display -p '#{session_name}')

# Build list of visible sessions
sessions=()
while read -r s; do
  case "$s" in _*) continue ;; esac   # hidden scratch sessions (e.g. _pc_<ws> popups)
  sessions+=("$s")
done < <(tmux list-sessions -F '#{session_name}')

[ ${#sessions[@]} -le 1 ] && tmux display-message "No other sessions" && exit 0

# Find current index
idx=0
for i in "${!sessions[@]}"; do
  [ "${sessions[$i]}" = "$current" ] && idx=$i
done

if [ "$1" = "next" ]; then
  idx=$(( (idx + 1) % ${#sessions[@]} ))
else
  idx=$(( (idx - 1 + ${#sessions[@]}) % ${#sessions[@]} ))
fi

tmux switch-client -t "${sessions[$idx]}"
