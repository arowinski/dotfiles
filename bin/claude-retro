#!/usr/bin/env python3
"""Analyze Claude Code daily usage for retro."""

import fnmatch
import json
import re
import statistics
import subprocess
import sys
from collections import defaultdict
from datetime import date, datetime, timedelta
from pathlib import Path

CLAUDE_DIR = Path.home() / ".claude"
HISTORY = CLAUDE_DIR / "history.jsonl"
PROJECTS = CLAUDE_DIR / "projects"
HOOK_LOG = CLAUDE_DIR / "hook-approvals.log"

MAX_PROMPTS_SHOWN = 10


def parse_date(arg):
    if not arg or arg == "today":
        return date.today()
    if arg == "yesterday":
        return date.today() - timedelta(days=1)
    return date.fromisoformat(arg)


def is_meta_prompt(prompt):
    stripped = prompt.strip().lower()
    return not stripped or stripped.startswith(("/", "!"))


def get_sessions(target):
    sessions = {}
    with open(HISTORY) as f:
        for line in f:
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue
            ts = datetime.fromtimestamp(entry["timestamp"] / 1000)
            if ts.date() != target:
                continue
            sid = entry["sessionId"]
            if sid not in sessions:
                sessions[sid] = {
                    "project": entry.get("project", "unknown"),
                    "prompts": [],
                    "start": ts,
                    "end": ts,
                }
            sessions[sid]["prompts"].append(entry.get("display", "").strip())
            sessions[sid]["end"] = max(sessions[sid]["end"], ts)
            sessions[sid]["start"] = min(sessions[sid]["start"], ts)
    return sessions


def is_agent_session(sid, project):
    encoded = project.replace("/", "-")
    path = PROJECTS / encoded / f"{sid}.jsonl"
    if not path.exists():
        return False, None, None
    with open(path) as f:
        try:
            first = json.loads(f.readline())
        except (json.JSONDecodeError, StopIteration):
            return False, None, None
    agent = first.get("agentName")
    team = first.get("teamName")
    if agent:
        return True, agent, team
    return False, None, None


def extract_commit_message(cmd, project=None):
    """Extract commit message from a git commit command."""
    # Match heredoc style: git commit -m "$(cat <<'EOF'\nmessage\nEOF\n)"
    m = re.search(r"<<'?EOF'?\n(.+?)\n\s*EOF", cmd, re.DOTALL)
    if m:
        msg = m.group(1).strip()
        # Remove Co-Authored-By lines
        msg = re.sub(r"\n\s*Co-Authored-By:.*", "", msg).strip()
        return msg
    # Match simple: git commit -m "message" (including multiline messages)
    m = re.search(r'git commit\s+-m\s+"((?:[^"\\]|\\.)*)"', cmd, re.DOTALL)
    if not m:
        m = re.search(r"git commit\s+-m\s+'((?:[^'\\]|\\.)*)'", cmd, re.DOTALL)
    if m:
        return m.group(1).strip()
    # Match reuse: git commit -C <sha> — resolve via git log in the project repo
    m = re.search(r"git commit\s+(?:[^|;&]*\s)?-C\s+([0-9a-f]{4,40})", cmd)
    if m and project:
        sha = m.group(1)
        try:
            out = subprocess.run(
                ["git", "-C", project, "log", "--format=%s", "-1", sha],
                capture_output=True, text=True, timeout=2,
            )
            if out.returncode == 0 and out.stdout.strip():
                return out.stdout.strip()
        except (subprocess.SubprocessError, OSError):
            pass
        return f"(reuse {sha[:8]})"
    # Match fixup/squash: git commit --fixup <ref>, --fixup=<ref>, --squash <ref>, --squash=<ref>
    m = re.search(r"git commit\s+(?:[^|;&]*\s)?--(fixup|squash)[=\s]+(\S+)", cmd)
    if m:
        return f"({m.group(1)} {m.group(2)})"
    return None


def count_net_commits(commands, project=None):
    """Count net commits and extract messages."""
    commits = []
    resets = 0
    # Only match `git commit` at a command-clause boundary (start of line or after && / ; / |)
    # to avoid false positives from commands that mention "git commit" inside quoted args.
    # Strip quoted substrings first so `git commit` inside single/double-quoted args (e.g.,
    # grep/jq patterns) doesn't trigger a match.
    commit_at_boundary = re.compile(r"(?:^|\n|;|&&|\|\|)\s*git commit\b")
    reset_at_boundary = re.compile(r"(?:^|\n|;|&&|\|\|)\s*git reset\b")
    quoted = re.compile(r"'(?:[^'\\]|\\.)*'|\"(?:[^\"\\]|\\.)*\"", re.DOTALL)
    for cmd in commands:
        stripped = quoted.sub("", cmd)
        if commit_at_boundary.search(stripped) and "--amend" not in stripped:
            msg = extract_commit_message(cmd, project)
            commits.append(msg or "(message not parsed)")
        elif reset_at_boundary.search(stripped) and re.search(r"HEAD~(\d+)", stripped):
            resets += int(re.search(r"HEAD~(\d+)", stripped).group(1))
    # Resets undo the most recent commits
    if resets > 0:
        commits = commits[:-resets] if resets < len(commits) else []
    return commits


# User messages the harness writes on the user's behalf; none of them ends a
# skill run or counts as the prompt after it.
HARNESS_PREFIXES = (
    "<command-",
    "<local-command",
    "<system-reminder>",
    "<task-notification>",
    "<teammate-message",
    "Another Claude session sent a message",
    "[Request interrupted",
)


def parse_ts(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00"))
    except (ValueError, AttributeError):
        return None


def usage_of(msg):
    u = msg.get("usage") or {}
    return {
        "cache_read": u.get("cache_read_input_tokens") or 0,
        "cache_create": u.get("cache_creation_input_tokens") or 0,
        "input": u.get("input_tokens") or 0,
        "output": u.get("output_tokens") or 0,
    }


def add_usage(total, u):
    for k, v in u.items():
        total[k] = total.get(k, 0) + v


def classify_prompt(prompt):
    """What the prompt right after a skill run says about the run."""
    if OVERACT_PATTERNS.search(prompt):
        return "overact"
    if is_correction(prompt):
        return "correction"
    if QUALITY_NAG_PATTERNS.search(prompt):
        return "nag"
    if QUERY_PATTERNS.search(prompt):
        return "query"
    return "accept"


def subagent_runs(sid, encoded):
    """(start, usage) per subagent transcript under <sid>/subagents/."""
    runs = []
    for path in sorted((PROJECTS / encoded / sid / "subagents").glob("agent-*.jsonl")):
        start, usage = None, {}
        with open(path) as f:
            for line in f:
                try:
                    e = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if e.get("type") != "assistant":
                    continue
                ts = parse_ts(e.get("timestamp", ""))
                if ts and (start is None or ts < start):
                    start = ts
                add_usage(usage, usage_of(e.get("message", {})))
        if start:
            runs.append((start, usage))
    return runs


def format_run(r):
    out = {
        "skill": r["skill"],
        "start": r["start"].astimezone().strftime("%H:%M") if r["start"] else None,
        "minutes": (
            round((r["end"] - r["start"]).total_seconds() / 60, 1)
            if r["start"] and r["end"]
            else None
        ),
        "tool_calls": r["tool_calls"],
        "tokens": sum(r["tokens"].values()),
        "output_tokens": r["tokens"].get("output", 0),
        "next": classify_prompt(r["next_prompt"]) if r["next_prompt"] else "none",
    }
    if r["args"]:
        out["args"] = r["args"]
    if r["agents"]:
        out["agents"] = dict(r["agents"])
    if r["nested"]:
        out["nested"] = r["nested"]
    if r["next_prompt"]:
        out["next_prompt"] = r["next_prompt"]
    return out


def collect_skill_runs(path, sid, encoded):
    """One run per user-initiated skill: a typed /skill (a `<command-name>` message
    without `<local-command-stdout>`, which marks UI commands) or a Skill tool_use
    with no run open. A run ends at the next real prompt; Skill calls inside it
    are recorded as nested. Tokens cover the main transcript's window plus every
    subagent transcript that started inside it."""
    runs = []
    open_run = None
    last_assistant_ts = None

    def new_run(name, args, ts):
        return {
            "skill": name,
            "args": (args or "")[:120],
            "start": ts,
            "tool_calls": 0,
            "agents": defaultdict(int),
            "nested": [],
            "tokens": {},
        }

    def close(end_ts, next_prompt=None):
        nonlocal open_run
        if open_run:
            open_run["end"] = end_ts or last_assistant_ts or open_run["start"]
            open_run["next_prompt"] = next_prompt
            # A UI command (/model, /copy) leaves no assistant turn behind.
            if open_run["tokens"] or open_run["tool_calls"]:
                runs.append(open_run)
            open_run = None

    with open(path) as f:
        for line in f:
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            msg = e.get("message", {})
            ts = parse_ts(e.get("timestamp", ""))
            role = msg.get("role")
            content = msg.get("content")

            if role == "user" and isinstance(content, str):
                m = re.search(r"<command-name>/([\w:-]+)</command-name>", content)
                if m and "<local-command-stdout>" not in content:
                    close(ts)
                    args = re.search(r"<command-args>(.*?)</command-args>", content, re.S)
                    open_run = new_run(m.group(1), args.group(1).strip() if args else "", ts)
                elif (
                    content.strip()
                    and not content.lstrip().startswith(HARNESS_PREFIXES)
                    and not is_meta_prompt(content)
                ):
                    close(ts, content[:120].replace("\n", " "))
                continue

            if role != "assistant":
                continue
            if ts:
                last_assistant_ts = ts
            if open_run:
                add_usage(open_run["tokens"], usage_of(msg))
            if not isinstance(content, list):
                continue
            for block in content:
                if not (isinstance(block, dict) and block.get("type") == "tool_use"):
                    continue
                name = block.get("name", "?")
                inp = block.get("input") or {}
                if name == "Skill":
                    if open_run:
                        open_run["nested"].append(inp.get("skill", "?"))
                    else:
                        open_run = new_run(inp.get("skill", "?"), inp.get("args", ""), ts)
                    continue
                if open_run:
                    open_run["tool_calls"] += 1
                    if name == "Agent":
                        open_run["agents"][inp.get("model") or "inherit"] += 1
    close(None)

    subs = subagent_runs(sid, encoded)
    for r in runs:
        for start, usage in subs:
            if r["start"] and r["end"] and r["start"] <= start <= r["end"]:
                add_usage(r["tokens"], usage)
    return [format_run(r) for r in runs]


def installed_skills():
    names = {p.parent.name for p in (CLAUDE_DIR / "skills").glob("*/SKILL.md")}
    names |= {p.stem for p in (CLAUDE_DIR / "commands").glob("*.md")}
    return sorted(names)


def analyze_session(sid, project, target_date=None):
    encoded = project.replace("/", "-")
    path = PROJECTS / encoded / f"{sid}.jsonl"
    if not path.exists():
        return {}
    target_prefix = str(target_date) if target_date else None

    tools = defaultdict(int)
    skills = defaultdict(int)  # skill name -> Skill tool invocations
    tool_errors = []
    models = defaultdict(int)
    teams = set()
    git_commands = []
    last_edit = None  # most recent Edit/Write tool_use info
    overact_signals = []  # [(file, excerpt, kind), ...] kind: "overact" | "query"

    with open(path) as f:
        for line in f:
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue

            if e.get("teamName"):
                teams.add(e["teamName"])

            msg = e.get("message", {})
            if model := msg.get("model"):
                models[model] += 1

            if msg.get("role") == "assistant" and isinstance(msg.get("content"), list):
                for block in msg["content"]:
                    if isinstance(block, dict) and block.get("type") == "tool_use":
                        name = block.get("name", "?")
                        tools[name] += 1
                        if name == "Skill":
                            skills[block.get("input", {}).get("skill", "?")] += 1
                        cmd = block.get("input", {}).get("command", "")
                        if re.search(r"git (commit|reset)\b", cmd):
                            git_commands.append(cmd)
                        if name in ("Edit", "Write"):
                            fp = block.get("input", {}).get("file_path", "?")
                            last_edit = fp.split("/")[-1] if fp else "?"

            if msg.get("role") == "user" and last_edit:
                content = msg.get("content")
                # Real user prompts are strings; array-content user messages are
                # tool_result entries from the harness, not prompts. Skip those.
                if isinstance(content, str) and content:
                    on_target_date = (
                        not target_prefix
                        or (e.get("timestamp", "")).startswith(target_prefix)
                    )
                    if on_target_date:
                        kind = None
                        if OVERACT_PATTERNS.search(content):
                            kind = "overact"
                        elif QUERY_PATTERNS.search(content):
                            kind = (
                                "overact"
                                if FRUSTRATION_PATTERNS.search(content)
                                else "query"
                            )
                        if kind:
                            overact_signals.append(
                                (last_edit, content[:120].replace("\n", " "), kind)
                            )
                    last_edit = None

            if msg.get("role") == "tool" and isinstance(msg.get("content"), list):
                for block in msg["content"]:
                    if isinstance(block, dict) and block.get("is_error"):
                        tool_errors.append(block.get("text", "")[:200])

    commit_messages = count_net_commits(git_commands, project)
    return {
        "tools": dict(tools),
        "skills": dict(skills),
        "skill_runs": collect_skill_runs(path, sid, encoded),
        "tool_errors": tool_errors[:10],
        "models": dict(models),
        "teams": sorted(teams),
        "commits": len(commit_messages),
        "commit_messages": commit_messages,
        "overact_signals": overact_signals,
    }


CORRECTION_PATTERNS = re.compile(
    r"^(no[,.]\s|stop[,.]\s|stop$|don'?t do |don'?t use |i said |i meant |that'?s not |wrong[,.]\s|not what |"
    r"wait what\b|this is wrong\b)",
    re.IGNORECASE,
)

# Mid-task quality nags: the output was accepted in kind but had to be re-asked
# for in shape ("make it concise", "use natural lang", "use the X skill"). They
# never open like a correction, so CORRECTION_PATTERNS misses every one. A nag
# in a session where a skill fired is a behavior gap in that skill. Read them;
# "shorter" also matches "shorter timeout" and "too long" a slow spec.
QUALITY_NAG_PATTERNS = re.compile(
    r"concise|shorter|too (long|verbose)|natural lang|plain (english|lang)|"
    r"cut (the )?fluff|less (words|text)|use (the )?[\w-]+ skill|use skills",
    re.IGNORECASE,
)

# Patterns where the user objects to something Claude just did unprompted.
# Used to detect Edit/Write actions immediately followed by an "over-act" complaint.
# Unauthorized-action complaints. These name the authorization itself, so a match
# is the user saying the work wasn't asked for.
OVERACT_PATTERNS = re.compile(
    r"i didn'?t ask|did i (tell|ask)|don'?t do (that|stuff)|"
    r"who asked|not what i asked|wasn'?t asked|i asked.*not",
    re.IGNORECASE,
)

# "why did you X" openers. These catch real overreach ("why did u add \"\"\" above
# the func?") but match design questions just as often ("why do u push it from
# gat-app, why not enqueue in the API?"), so they are reported separately and
# never counted as overact signals. Read them; don't trust the count.
QUERY_PATTERNS = re.compile(
    r"why (u|did u|did you) |why use |why update|why add|why change|"
    r"why move|why rewrite|why wrap|why do ",
    re.IGNORECASE,
)

# A "why did you X" carrying one of these isn't a design question. Promotes a
# QUERY match back to overact.
FRUSTRATION_PATTERNS = re.compile(
    r"what the fuck|\bwtf\b|\bffs\b|for fuck'?s sake|are you kidding",
    re.IGNORECASE,
)


def is_correction(prompt):
    """A correction opener, or a frustration marker anywhere ("FFS, can't u do
    proper research", "wait what? what are u doing", "This is wrong")."""
    return bool(CORRECTION_PATTERNS.search(prompt) or FRUSTRATION_PATTERNS.search(prompt))


def count_corrections(prompts):
    """Count prompts that look like corrections or restatements."""
    return sum(1 for p in prompts if is_correction(p))


def count_quality_nags(prompts):
    """Count prompts that re-ask for the output's shape (concise, natural, via skill)."""
    return sum(1 for p in prompts if QUALITY_NAG_PATTERNS.search(p))


def cap_prompts(prompts):
    """Return first/last N prompts if list is too long, filtering meta prompts.

    Always includes correction- and nag-matching prompts regardless of position.
    """
    work_prompts = [p for p in prompts if not is_meta_prompt(p)]
    total = len(work_prompts)
    corrections = count_corrections(work_prompts)
    quality_nags = count_quality_nags(work_prompts)
    if total <= MAX_PROMPTS_SHOWN:
        return work_prompts, total, corrections, quality_nags
    half = MAX_PROMPTS_SHOWN // 2
    head = set(range(half))
    tail = set(range(total - half, total))
    keep = head | tail
    # Always include correction and nag prompts from the middle
    for i, p in enumerate(work_prompts):
        if is_correction(p) or QUALITY_NAG_PATTERNS.search(p):
            keep.add(i)
    capped = []
    prev = -1
    for i in sorted(keep):
        if i > prev + 1:
            skipped = i - prev - 1
            capped.append(f"... ({skipped} more) ...")
        capped.append(work_prompts[i])
        prev = i
    if prev < total - 1:
        capped.append(f"... ({total - prev - 1} more) ...")
    return capped, total, corrections, quality_nags


# Extract base command: two words for git/bundle, first word otherwise
BASE_CMD = re.compile(r"^((?:git|bundle)\s+[a-z][\w-]*|[a-z][\w-]*)")


def parse_hook_log(target):
    """Parse hook-approvals.log for permission friction on target date.

    dippy logs its own decision before bin/dippy-auto filters it. In auto mode
    only an ask carrying a "Confirm:" message reaches the user as a prompt; any
    other ask goes to the auto-mode classifier, costing a classifier call
    rather than a prompt.
    """
    if not HOOK_LOG.exists():
        return {"ask_count": 0, "approved_count": 0, "top_ask": [], "classifier_count": 0, "top_classifier": []}

    # The hook logs one line per line of a multi-line command, all stamped with
    # the same second, so count events as distinct timestamps, not lines.
    prefix = str(target)
    ask_cmds = defaultdict(set)
    classifier_cmds = defaultdict(set)
    approved = set()
    asks = set()
    to_classifier = set()

    with open(HOOK_LOG) as f:
        for line in f:
            if not line.startswith(prefix):
                continue
            stamp = line[:19]
            if "APPROVED:" in line:
                approved.add(stamp)
            elif "ASK:" in line:
                prompted = ": Confirm:" in line
                (asks if prompted else to_classifier).add(stamp)
                cmds = ask_cmds if prompted else classifier_cmds
                m = re.search(r"ASK: (.+)$", line)
                if m:
                    for part in m.group(1).split(","):
                        # "parse error" names no command; "command substitution: X" is about X.
                        part = part.strip().removeprefix("command substitution: ")
                        cm = BASE_CMD.match(part)
                        if cm and not part.startswith("parse error"):
                            cmds[cm.group(1)].add(stamp)

    def top(cmds):
        ranked = sorted(((cmd, len(s)) for cmd, s in cmds.items()), key=lambda x: -x[1])[:10]
        return [{"command": cmd, "count": n} for cmd, n in ranked]

    return {
        "ask_count": len(asks),
        "approved_count": len(approved),
        "top_ask": top(ask_cmds),
        "classifier_count": len(to_classifier),
        "top_classifier": top(classifier_cmds),
        "unused_allow": unused_allow(target),
    }


# Anchored: a tool result that merely quotes this text (a grep over transcripts) isn't a denial.
CLASSIFIER_DENIAL = re.compile(
    r"Permission for this action was denied by the Claude Code auto mode classifier\. Reason: \[([^\]]+)\]"
)


def classifier_denials(sid, encoded, target):
    """Auto-mode classifier blocks on target date, in the session and its subagents."""
    prefix = str(target)
    paths = [PROJECTS / encoded / f"{sid}.jsonl"]
    paths += sorted((PROJECTS / encoded / sid / "subagents").glob("agent-*.jsonl"))
    denials = []
    for path in paths:
        if not path.exists():
            continue
        calls = {}  # tool_use id -> "Tool <command or path>"
        with open(path) as f:
            for line in f:
                try:
                    e = json.loads(line)
                except json.JSONDecodeError:
                    continue
                content = e.get("message", {}).get("content")
                if not isinstance(content, list):
                    continue
                for block in content:
                    if not isinstance(block, dict):
                        continue
                    if block.get("type") == "tool_use":
                        inp = block.get("input", {})
                        target_of = inp.get("command") or inp.get("file_path") or ""
                        calls[block.get("id")] = f"{block.get('name', '?')} {target_of}".strip()[:120]
                    elif block.get("type") == "tool_result" and e.get("timestamp", "").startswith(prefix):
                        result = block.get("content")
                        if isinstance(result, list):
                            result = next((c.get("text", "") for c in result if isinstance(c, dict)), "")
                        m = CLASSIFIER_DENIAL.match(result or "")
                        if m:
                            denials.append({"rule": m.group(1), "call": calls.get(block.get("tool_use_id"), "?")})
    return denials


UNUSED_ALLOW_DAYS = 30
SUBCOMMAND_SPLIT = re.compile(r"&&|\|\||;|\||\n")


def allow_matches(rule, cmd):
    """Claude Code Bash rule semantics: `x:*` is a word prefix, `*` a glob, else exact."""
    if rule.endswith(":*"):
        prefix = rule[:-2]
        return cmd == prefix or cmd.startswith(prefix + " ")
    if "*" in rule:
        return fnmatch.fnmatchcase(cmd, rule)
    return cmd == rule


def unused_allow(target):
    """Bash allow rules in settings.json that no Bash call matched in the window."""
    try:
        allow = json.loads((CLAUDE_DIR / "settings.json").read_text())["permissions"]["allow"]
    except (OSError, KeyError, json.JSONDecodeError):
        return []
    rules = {r: r[5:-1] for r in allow if r.startswith("Bash(") and r.endswith(")")}
    unmatched = dict(rules)

    since = datetime.combine(target - timedelta(days=UNUSED_ALLOW_DAYS), datetime.min.time()).timestamp()
    for path in PROJECTS.glob("**/*.jsonl"):
        if not unmatched:
            break
        try:
            if path.stat().st_mtime < since:
                continue
            f = open(path)
        except OSError:
            continue
        with f:
            for line in f:
                # Cheap filter before parsing: only lines carrying a Bash tool call.
                if '"name":"Bash"' not in line:
                    continue
                try:
                    content = json.loads(line)["message"]["content"]
                except (json.JSONDecodeError, KeyError, TypeError):
                    continue
                for item in content if isinstance(content, list) else []:
                    if item.get("type") != "tool_use" or item.get("name") != "Bash":
                        continue
                    for part in SUBCOMMAND_SPLIT.split(item.get("input", {}).get("command", "")):
                        part = part.strip()
                        for rule, pattern in list(unmatched.items()):
                            if allow_matches(pattern, part):
                                del unmatched[rule]

    return sorted(unmatched)


def main():
    target = parse_date(sys.argv[1] if len(sys.argv) > 1 else "today")
    sessions = get_sessions(target)

    if not sessions:
        json.dump({"date": str(target), "summary": "No sessions found"}, sys.stdout)
        return

    by_project = defaultdict(lambda: {"user": [], "agent": []})
    all_errors = []
    all_tools = defaultdict(int)
    all_models = defaultdict(int)
    all_teams = set()
    total_commits = 0
    total_work_prompts = 0
    short_sessions = 0
    user_session_count = 0
    agent_session_count = 0
    total_overact = 0
    overact_samples = []
    total_query = 0
    query_samples = []
    denial_samples = []
    skill_stats = defaultdict(
        lambda: {"runs": 0, "minutes": [], "tokens": [], "after": defaultdict(int)}
    )

    for sid, info in sessions.items():
        is_agent, agent_name, team_name = is_agent_session(sid, info["project"])
        detail = analyze_session(sid, info["project"], target_date=target)
        dur = round((info["end"] - info["start"]).total_seconds() / 60, 1)

        capped, work_count, corrections, quality_nags = cap_prompts(info["prompts"])
        meta_count = len(info["prompts"]) - work_count

        # Intent = first non-meta prompt
        work_prompts = [p for p in info["prompts"] if not is_meta_prompt(p)]
        intent = work_prompts[0] if work_prompts else None
        outcome = "committed" if detail.get("commits", 0) > 0 else "no-commit"

        signals = detail.pop("overact_signals", [])
        if not detail.get("skills"):
            detail.pop("skills", None)
        for run in detail.get("skill_runs") or []:
            st = skill_stats[run["skill"]]
            st["runs"] += 1
            if run["minutes"] is not None:
                st["minutes"].append(run["minutes"])
            st["tokens"].append(run["tokens"])
            st["after"][run["next"]] += 1
        if not detail.get("skill_runs"):
            detail.pop("skill_runs", None)

        s = {
            "id": sid[:8],
            "intent": intent,
            "outcome": outcome,
            "prompts": capped,
            "prompt_count": work_count,
            "start": info["start"].strftime("%H:%M"),
            "end": info["end"].strftime("%H:%M"),
            "duration_min": dur,
            **detail,
        }
        if meta_count:
            s["meta_prompts_filtered"] = meta_count
        if corrections:
            s["corrections"] = corrections
        if quality_nags:
            s["quality_nags"] = quality_nags
        denials = classifier_denials(sid, info["project"].replace("/", "-"), target)
        if denials:
            s["classifier_denials"] = len(denials)
            denial_samples.extend({"session": sid[:8], **d} for d in denials)
        overact = [sig for sig in signals if sig[2] == "overact"]
        queries = [sig for sig in signals if sig[2] == "query"]
        if overact:
            s["overact_signals"] = len(overact)
            total_overact += len(overact)
            for sig in overact:
                overact_samples.append({
                    "session": sid[:8],
                    "file": sig[0],
                    "complaint": sig[1],
                })
        if queries:
            s["query_signals"] = len(queries)
            total_query += len(queries)
            for sig in queries:
                query_samples.append({
                    "session": sid[:8],
                    "file": sig[0],
                    "question": sig[1],
                })
        if work_count:
            model_calls = sum(detail.get("models", {}).values())
            s["model_calls_per_prompt"] = round(model_calls / work_count, 1)

        if is_agent:
            s["agent"] = agent_name
            s["team"] = team_name
            agent_session_count += 1
        else:
            user_session_count += 1
            total_work_prompts += work_count
            if dur < 2 and work_count <= 2:
                short_sessions += 1

        all_errors.extend(detail.get("tool_errors", []))
        total_commits += detail.get("commits", 0)
        for t, c in detail.get("tools", {}).items():
            all_tools[t] += c
        for m, c in detail.get("models", {}).items():
            all_models[m] += c
        all_teams.update(detail.get("teams", []))

        project = info["project"].split("/")[-1]
        bucket = "agent" if is_agent else "user"
        by_project[project][bucket].append(s)

    project_wall_clock = {}
    for project, buckets in by_project.items():
        user_sessions = buckets["user"]
        if user_sessions:
            starts = [s["start"] for s in user_sessions]
            ends = [s["end"] for s in user_sessions]
            project_wall_clock[project] = {"from": min(starts), "to": max(ends)}

    output = {
        "date": str(target),
        "summary": {
            "user_sessions": user_session_count,
            "agent_sessions": agent_session_count,
            "work_prompts": total_work_prompts,
            "commits": total_commits,
            "short_sessions": short_sessions,
            "tool_errors": len(all_errors),
            "models": dict(all_models),
            "top_tools": dict(sorted(all_tools.items(), key=lambda x: -x[1])[:10]),
            "teams": sorted(all_teams),
            "overact_signals": total_overact,
            "query_signals": total_query,
            "skill_runs": {
                skill: {
                    "runs": st["runs"],
                    "median_min": round(statistics.median(st["minutes"]), 1)
                    if st["minutes"]
                    else None,
                    "median_tokens": int(statistics.median(st["tokens"])),
                    "after": dict(st["after"]),
                }
                for skill, st in sorted(skill_stats.items())
            },
        },
        "installed_skills": installed_skills(),
        "projects": {},
    }
    if overact_samples:
        output["overact_samples"] = overact_samples[:20]
    if query_samples:
        output["query_samples"] = query_samples[:20]

    for project, buckets in sorted(by_project.items()):
        user_sessions = buckets["user"]
        agent_sessions = buckets["agent"]
        all_commit_msgs = []
        for s in user_sessions:
            all_commit_msgs.extend(s.get("commit_messages", []))

        p = {
            "user_sessions": len(user_sessions),
            "prompts": sum(s["prompt_count"] for s in user_sessions),
            "commits": sum(s.get("commits", 0) for s in user_sessions),
        }
        if all_commit_msgs:
            p["commit_messages"] = all_commit_msgs
        if project in project_wall_clock:
            p["wall_clock"] = project_wall_clock[project]
        if user_sessions:
            p["details"] = user_sessions
        if agent_sessions:
            p["agent_sessions"] = len(agent_sessions)
            p["agents"] = [
                {"agent": s.get("agent"), "team": s.get("team")}
                for s in agent_sessions
            ]
        output["projects"][project] = p

    if all_errors:
        output["error_samples"] = all_errors[:15]

    output["permissions"] = parse_hook_log(target)
    output["permissions"]["classifier_denials"] = len(denial_samples)
    if denial_samples:
        output["permissions"]["classifier_denial_samples"] = denial_samples[:15]

    json.dump(output, sys.stdout, indent=2, default=str)


if __name__ == "__main__":
    main()
