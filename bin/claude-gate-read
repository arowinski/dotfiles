#!/bin/bash
#
# PreToolUse gate on Read: refuse a full read of a text file over 16KB,
# roughly 4k tokens. Bytes rather than lines because cost is in tokens
# and a line count lets long-line JSON, lockfiles and generated code through.
#
# A targeted read (offset or limit) passes, as does anything binary or
# missing. The refusal names the alternatives so the model picks the
# section it needs or hands the question to an Explore agent and keeps
# the answer instead of the file.
#
# Wired in claude/settings.json under hooks.PreToolUse with matcher "Read".
set -euo pipefail

max_kb=16
input=$(cat)
path=$(printf '%s' "$input" | jq -r '.tool_input.file_path // empty')
bounded=$(printf '%s' "$input" | jq -r '(.tool_input.offset // .tool_input.limit // empty) | tostring')

[ -n "$path" ] && [ -z "$bounded" ] && [ -f "$path" ] || exit 0
grep -Iq . "$path" 2>/dev/null || exit 0
kb=$(( $(wc -c < "$path") / 1024 ))
[ "$kb" -gt "$max_kb" ] || exit 0

jq -n --arg p "$path" --arg n "$kb" --arg m "$max_kb" '{
  hookSpecificOutput: {
    hookEventName: "PreToolUse",
    permissionDecision: "deny",
    permissionDecisionReason: ("Blocked: " + $p + " is " + $n + "KB; full reads stop at " + $m + "KB. Read the section you need with offset and limit, or hand your question to an Explore agent and keep its answer, not the file.")
  }
}'
