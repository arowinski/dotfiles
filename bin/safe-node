#!/usr/bin/env bash
# Run Node.js in a network-isolated Docker container.
# Usage: safe-node -e 'console.log("hello")'
#        safe-node script.js
#        echo '{"key": "value"}' | safe-node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>console.log(JSON.parse(s).key))'

CONTAINER_NAME="node-sandbox"

# Ensure container is running
if ! docker inspect "$CONTAINER_NAME" &>/dev/null; then
  docker run -d \
    --name "$CONTAINER_NAME" \
    --network none \
    --read-only \
    --tmpfs /tmp \
    -v "${HOME}/gat:/workspace:ro" \
    -v "${HOME}/Dev:/dev-workspace:ro" \
    -w /workspace \
    node:lts-alpine \
    sleep infinity >/dev/null
elif [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME")" != "true" ]; then
  docker start "$CONTAINER_NAME" >/dev/null
fi

# Pass stdin if available, forward all arguments
if [ -t 0 ]; then
  docker exec "$CONTAINER_NAME" node "$@"
else
  docker exec -i "$CONTAINER_NAME" node "$@"
fi
